<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000">

    <!-- ═══════════════════════════════════════════
         CAMERA STATE
    ════════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/cameraContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.camera.view.PreviewView
            android:id="@+id/viewFinder"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Top gradient -->
        <View
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="@drawable/gradient_top" />

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="28dp"
            android:paddingHorizontal="8dp"
            android:paddingBottom="8dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Назад" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Фото таблицы"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Снимайте таблицу целиком"
                android:textColor="#88FFFFFF"
                android:textSize="11sp"
                android:paddingEnd="8dp" />
        </LinearLayout>

        <!-- Zoom controls -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="60dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#66000000"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnZoomOut"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="−"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:padding="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp" />

            <TextView
                android:id="@+id/tvZoomLevel"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:text="1.0×"
                android:textColor="#DDFFFFFF"
                android:textSize="14sp"
                android:gravity="center"
                android:fontFamily="monospace" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnZoomIn"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:padding="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp" />
        </LinearLayout>

        <!-- Capture + gallery row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="120dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGallery"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:text="ГАЛЕРЕЯ"
                android:textColor="#DDFFFFFF"
                android:textSize="12sp"
                android:paddingHorizontal="16dp"
                android:layout_marginEnd="24dp"
                app:strokeColor="#55FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCapture"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:text="●"
                android:textSize="24sp"
                android:textColor="#FFFFFF"
                android:padding="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                app:backgroundTint="#CC0D1B2A"
                app:strokeColor="#CCFFFFFF"
                app:strokeWidth="2dp"
                app:cornerRadius="35dp" />
        </LinearLayout>

        <!-- Processing spinner (shown during OCR) -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:indeterminateTint="#2196F3"
            android:visibility="gone" />

    </FrameLayout>

    <!-- ═══════════════════════════════════════════
         RESULTS STATE
    ════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/resultsContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#0A1628"
        android:visibility="gone">

        <!-- Header bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#08111E"
            android:paddingHorizontal="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddMore"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ Ещё фото"
                android:textColor="#2196F3"
                android:textSize="13sp"
                android:padding="8dp"
                android:minWidth="0dp"
                android:minHeight="0dp" />

            <TextView
                android:id="@+id/tvResultCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Найдено: 0"
                android:textColor="#8BB4D8"
                android:textSize="13sp"
                android:gravity="center" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearResults"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Очистить"
                android:textColor="#EF5350"
                android:textSize="13sp"
                android:padding="8dp"
                android:minWidth="0dp"
                android:minHeight="0dp" />
        </LinearLayout>

        <!-- Column picker: shown when OCR finds multiple text columns in the table -->
        <LinearLayout
            android:id="@+id/columnPickerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="0dp"
            android:background="#0A1628"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Имя из столбца таблицы:"
                android:textColor="#8BB4D8"
                android:textSize="11sp"
                android:layout_marginBottom="6dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:id="@+id/columnPickerRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Batch name field -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="4dp"
            android:background="#0A1628">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Или одно название для всех:"
                android:textColor="#8BB4D8"
                android:textSize="11sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etBatchName"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/edit_bg"
                android:paddingHorizontal="12dp"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textColorHint="#4D6E8A"
                android:hint="Точка"
                android:inputType="text"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Batch color picker -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:background="#0A1628">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Цвет:"
                android:textColor="#8BB4D8"
                android:textSize="12sp"
                android:layout_marginEnd="8dp" />

            <View android:id="@+id/batchColorBlue"
                android:layout_width="32dp" android:layout_height="32dp"
                android:layout_margin="4dp"
                android:background="@drawable/color_circle"
                android:backgroundTint="#0055FF" />
            <View android:id="@+id/batchColorRed"
                android:layout_width="32dp" android:layout_height="32dp"
                android:layout_margin="4dp"
                android:background="@drawable/color_circle"
                android:backgroundTint="#FF2020" />
            <View android:id="@+id/batchColorGreen"
                android:layout_width="32dp" android:layout_height="32dp"
                android:layout_margin="4dp"
                android:background="@drawable/color_circle"
                android:backgroundTint="#00BB00" />
            <View android:id="@+id/batchColorOrange"
                android:layout_width="32dp" android:layout_height="32dp"
                android:layout_margin="4dp"
                android:background="@drawable/color_circle"
                android:backgroundTint="#FF8800" />
            <View android:id="@+id/batchColorYellow"
                android:layout_width="32dp" android:layout_height="32dp"
                android:layout_margin="4dp"
                android:background="@drawable/color_circle"
                android:backgroundTint="#FFD700" />
            <View android:id="@+id/batchColorPurple"
                android:layout_width="32dp" android:layout_height="32dp"
                android:layout_margin="4dp"
                android:background="@drawable/color_circle"
                android:backgroundTint="#9900CC" />
            <View android:id="@+id/batchColorWhite"
                android:layout_width="32dp" android:layout_height="32dp"
                android:layout_margin="4dp"
                android:background="@drawable/color_circle"
                android:backgroundTint="#FFFFFF" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1C3050" />

        <!-- Select all row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:background="#0F1E30">

            <CheckBox
                android:id="@+id/checkboxSelectAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:buttonTint="#2196F3"
                android:checked="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Выбрать все"
                android:textColor="#DDFFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Thin divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1C3050" />

        <!-- Coordinates list -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerResults"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingVertical="4dp"
            android:clipToPadding="false" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1C3050" />

        <!-- Save button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveSelected"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="12dp"
            android:text="СОХРАНИТЬ (0)"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            app:backgroundTint="#2196F3"
            app:cornerRadius="8dp" />

    </LinearLayout>

    <SeekBar
        android:id="@+id/seekbarZoom"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="4dp"
        android:rotation="270"
        android:max="100"
        android:progress="0"
        android:progressTint="#CCFFFFFF"
        android:thumbTint="#FFFFFF" />

    <TextView
        android:id="@+id/tvAi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="8dp"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="🤖 AI"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:background="#66000000"
        android:clickable="true"
        android:focusable="true"
        android:longClickable="true" />

</FrameLayout>
