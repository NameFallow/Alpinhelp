<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy_bg">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/navy_deep"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/navy_deep"
            app:titleTextColor="@color/white" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="100dp">

            <!-- Переключатель системы координат -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleCoordMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="12dp"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnInputSk42"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="42dp"
                    android:text="СК-42"
                    android:textColor="@color/white"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnInputWgs84"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="42dp"
                    android:text="WGS-84"
                    android:textColor="@color/white"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="4dp"
                android:text="Вставь данные построчно — каждая строка одна точка. Или жми «Вставить таблицу» и пасти прямоугольник из Excel/Calc целиком — раскидаем по колонкам."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- Поле X / широта -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilX"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="10dp"
                app:boxBackgroundColor="@color/navy_card"
                app:boxStrokeColor="@color/navy_stroke"
                app:hintTextColor="@color/text_secondary"
                android:hint="X СК-42 (по одной на строку)">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etX"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|numberDecimal|numberSigned"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:scrollbars="vertical"
                    android:overScrollMode="always" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Поле Y / долгота -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilY"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="10dp"
                app:boxBackgroundColor="@color/navy_card"
                app:boxStrokeColor="@color/navy_stroke"
                app:hintTextColor="@color/text_secondary"
                android:hint="Y СК-42 (по одной на строку)">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etY"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|numberDecimal|numberSigned"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:scrollbars="vertical"
                    android:overScrollMode="always" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Поле имён -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="10dp"
                app:boxBackgroundColor="@color/navy_card"
                app:boxStrokeColor="@color/navy_stroke"
                app:hintTextColor="@color/text_secondary"
                android:hint="Названия (по одному на строку)">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:scrollbars="vertical"
                    android:overScrollMode="always" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Кнопки управления -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="14dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPasteTable"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:text="Вставить таблицу"
                    android:textColor="@color/accent"
                    android:layout_marginEnd="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBuild"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:text="Собрать таблицу"
                    app:backgroundTint="@color/primary"
                    android:textColor="@color/white"
                    android:layout_marginEnd="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearAll"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="Очистить"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <!-- Статус таблицы -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginHorizontal="14dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/tvCount"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Таблица пуста"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnIconForAll"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Иконка для всех"
                    android:textColor="@color/accent"
                    android:textSize="12sp"
                    android:minWidth="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingBottom="8dp" />

            <!-- Финальные действия -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="14dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveAll"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="50dp"
                    android:text="Сохранить в список"
                    android:textColor="@color/white"
                    android:layout_marginEnd="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportKmz"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="50dp"
                    android:text="Экспорт KMZ"
                    app:backgroundTint="@color/accent"
                    android:textColor="@color/navy_deep"
                    app:icon="@android:drawable/ic_menu_share"
                    app:iconTint="@color/navy_deep" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
