<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp"
    android:background="@color/navy_surface">

    <!-- Ручка -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@color/navy_stroke" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Слой карты"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLayerOsm"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="8dp"
        android:text="🗺 OpenStreetMap"
        android:textColor="@color/text_primary"
        android:gravity="start|center_vertical"
        android:paddingStart="12dp"
        app:strokeColor="@color/navy_stroke" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLayerSatellite"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="8dp"
        android:text="🛰 Google Спутник"
        android:textColor="@color/text_primary"
        android:gravity="start|center_vertical"
        android:paddingStart="12dp"
        app:strokeColor="@color/navy_stroke" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLayerHybrid"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="🛰 Google Гибрид (спутник + дороги)"
        android:textColor="@color/text_primary"
        android:gravity="start|center_vertical"
        android:paddingStart="12dp"
        app:strokeColor="@color/navy_stroke" />

</LinearLayout>
