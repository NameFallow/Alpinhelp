<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000">

    <!-- Camera preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Coordinate highlight overlay -->
    <com.coordscanner.CameraOverlayView
        android:id="@+id/overlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top gradient for readability -->
    <View
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@drawable/gradient_top" />

    <!-- Floating top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="28dp"
        android:paddingHorizontal="8dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Назад" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Сканирование"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDebug"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="OCR"
            android:textColor="#AAFFFFFF"
            android:textSize="11sp"
            android:paddingHorizontal="10dp"
            app:strokeColor="#44FFFFFF" />
    </LinearLayout>

    <!-- Coordinate system mode toggle -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleCoordsMode"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="80dp"
        app:checkedButton="@id/btnModeSk42"
        app:singleSelection="true"
        app:selectionRequired="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeSk42"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="СК-42 / Пулково"
            android:textColor="#DDFFFFFF"
            android:textSize="12sp"
            android:paddingHorizontal="14dp"
            app:strokeColor="#55FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeWgs84"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="WGS-84"
            android:textColor="#DDFFFFFF"
            android:textSize="12sp"
            android:paddingHorizontal="14dp"
            app:strokeColor="#55FFFFFF" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- OCR debug panel (hidden by default) -->
    <ScrollView
        android:id="@+id/scrollDebug"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:layout_marginTop="84dp"
        android:visibility="gone"
        android:background="#EE06111E">

        <TextView
            android:id="@+id/tvDebugOcr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#CCFFFFFF"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:padding="8dp" />
    </ScrollView>

    <!-- Scanning status pill -->
    <LinearLayout
        android:id="@+id/statusPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="252dp"
        android:background="@drawable/status_pill_bg"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <ProgressBar
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:indeterminateTint="@color/primary"
            style="?android:attr/progressBarStyleSmall" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Наведите на координаты"
            android:textColor="#DDFFFFFF"
            android:textSize="13sp"
            android:paddingStart="10dp" />
    </LinearLayout>

    <!-- Confirmation card — starts off-screen, slides up on detection -->
    <LinearLayout
        android:id="@+id/confirmCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/confirm_card_bg"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="28dp"
        android:elevation="16dp">

        <!-- Drag handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/pill_handle" />

        <!-- Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Координаты распознаны"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tvConfirmSystem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="СК-42"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:background="@drawable/badge_bg" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/navy_stroke"
            android:layout_marginBottom="14dp" />

        <!-- Coordinate display -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="СК-42"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvConfirmSk42"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WGS-84"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvConfirmWgs84"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@color/accent"
                    android:textSize="14sp"
                    android:fontFamily="monospace" />
            </LinearLayout>
        </LinearLayout>

        <!-- Name field -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Название точки"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etConfirmName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/edit_bg"
            android:paddingHorizontal="12dp"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textColorHint="@color/text_hint"
            android:hint="Точка"
            android:inputType="text"
            android:maxLines="1"
            android:layout_marginBottom="16dp" />

        <!-- Color picker -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Цвет точки на карте"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="start"
            android:layout_marginBottom="16dp">

            <View
                android:id="@+id/colorDotBlue"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_margin="5dp"
                android:background="@drawable/color_circle"
                android:backgroundTint="#0055FF" />

            <View
                android:id="@+id/colorDotRed"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_margin="5dp"
                android:background="@drawable/color_circle"
                android:backgroundTint="#FF2020" />

            <View
                android:id="@+id/colorDotGreen"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_margin="5dp"
                android:background="@drawable/color_circle"
                android:backgroundTint="#00BB00" />

            <View
                android:id="@+id/colorDotOrange"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_margin="5dp"
                android:background="@drawable/color_circle"
                android:backgroundTint="#FF8800" />

            <View
                android:id="@+id/colorDotYellow"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_margin="5dp"
                android:background="@drawable/color_circle"
                android:backgroundTint="#FFD700" />

            <View
                android:id="@+id/colorDotPurple"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_margin="5dp"
                android:background="@drawable/color_circle"
                android:backgroundTint="#9900CC" />
        </LinearLayout>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNo"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:text="НЕТ"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                app:strokeColor="@color/navy_stroke" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="2"
                android:text="СОХРАНИТЬ"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                app:backgroundTint="@color/primary" />
        </LinearLayout>

        <!-- Saved feedback -->
        <TextView
            android:id="@+id/tvLastPoint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/scanner_green"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="10dp"
            android:visibility="invisible" />
    </LinearLayout>


    <!-- Zoom controls -->
    <LinearLayout
        android:id="@+id/zoomControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#66000000"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnZoomOut"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="−"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <TextView
            android:id="@+id/tvZoomLevel"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:text="1.0×"
            android:textColor="#DDFFFFFF"
            android:textSize="14sp"
            android:gravity="center"
            android:fontFamily="monospace" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnZoomIn"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />
    </LinearLayout>

    <!-- Photo capture + gallery buttons -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="128dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGallery"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:text="ГАЛЕРЕЯ"
            android:textColor="#DDFFFFFF"
            android:textSize="12sp"
            android:paddingHorizontal="16dp"
            android:layout_marginEnd="24dp"
            app:strokeColor="#55FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCapture"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:text="●"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            app:backgroundTint="#CC0D1B2A"
            app:strokeColor="#CCFFFFFF"
            app:strokeWidth="2dp"
            app:cornerRadius="33dp" />
    </LinearLayout>

</FrameLayout>
