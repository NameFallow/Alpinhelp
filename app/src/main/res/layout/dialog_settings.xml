<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/tv_ai_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="🤖 Автосканер активен" />

    <TextView
        android:id="@+id/tv_ai_reason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="13sp"
        android:textColor="?android:attr/textColorSecondary"
        tools:text="Всё в порядке" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_reset_ai_status"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginTop="6dp"
        android:text="Сбросить статус"
        android:textSize="11sp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingHorizontal="12dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        android:background="?android:attr/listDivider" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ключ Anthropic Claude (sk-ant-…)"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/et_anthropic_key"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:hint="вставь ключ — без него распознавание не работает"
        android:inputType="textPassword"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Бесплатный ключ: console.anthropic.com → Settings → API Keys"
        android:textSize="11sp"
        android:textColor="?android:attr/textColorSecondary" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Ключ OpenRouter (sk-or-…) — резерв"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/et_openrouter_key"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:hint="оставь пустым — резерв выключен"
        android:inputType="textPassword"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Ключ: openrouter.ai → Keys (один ключ → GPT-4o, Claude, Gemini, Qwen)"
        android:textSize="11sp"
        android:textColor="?android:attr/textColorSecondary" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Ключ Groq (gsk_…) — бесплатный резерв"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/et_groq_key"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:hint="оставь пустым — резерв выключен"
        android:inputType="textPassword"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Бесплатный ключ: console.groq.com → API Keys (Llama 3.2 Vision)"
        android:textSize="11sp"
        android:textColor="?android:attr/textColorSecondary" />

    <!-- Поле Gemini скрыто — провайдер недоступен в регионе. Оставляю в layout
         на случай возврата, но не отображается. -->
    <EditText
        android:id="@+id/et_gemini_key"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:inputType="textPassword" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        android:background="?android:attr/listDivider" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_cs_title"
        android:textSize="14sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rg_cs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/rb_sk42"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="СК-42  (Гаусс-Крюгер)" />

        <RadioButton
            android:id="@+id/rb_wgs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WGS-84  (широта / долгота °)" />
    </RadioGroup>
</LinearLayout>

</ScrollView>
